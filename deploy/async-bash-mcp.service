[Unit]
Description=async-bash MCP server (single long-lived streamable-HTTP instance)
Documentation=file:%h/codes/async-bash-mcp/deploy/README.md
After=network.target

[Service]
Type=simple
Environment=PORT=8769
Environment=HOST=127.0.0.1
# Commands run through "$SHELL -c"; without this the unit inherits zsh from the
# systemd user manager, and zsh does not word-split unquoted variables.
Environment=SHELL=/usr/bin/bash
# spawn(cwd=None) lands here. Ephemeral scratch, so a forgotten cwd cannot
# write into $HOME or a repo root.
ExecStartPre=/usr/bin/mkdir -p /tmp/opencode
WorkingDirectory=/tmp/opencode
# Default soft limit (1024) is too low for big builds and dev servers.
LimitNOFILE=65536
ExecStart=%h/codes/async-bash-mcp/deploy/serve.sh
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
